#!ipxe
# Manual/emergency entry point.
#
# The normal chain is:
#   DHCP -> ipxe.efi -> ipxe/boot.ipxe -> boot.ipxe.php -> ESXi installer
#
# boot.ipxe.php reads the selected version's boot.cfg and emits the full
# kernel + module list, so nothing here needs to know a version or an
# address. Use this file only to re-enter the chain from the iPXE shell:
#
#   chain http://${next-server}/ipxe/esxi.ipxe
#
# ${next-server} comes from DHCP (siaddr); it is never hardcoded.
echo Re-entering the ESXi deployment chain via ${next-server}
chain http://${next-server}/boot.ipxe.php?mac=${net0/mac}&serial=${smbios/serial}
