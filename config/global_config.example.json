{
    "_comment": "Copy to global_config.json and replace every CHANGEME value. Never commit the live file.",
    "deployment": {
        "esxi_versions": {
            "8.0U3": {
                "path": "/srv/autodeploy/esxi/8.0U3",
                "description": "ESXi 8.0 Update 3"
            }
        },
        "kickstart_templates": {
            "standard": "/srv/autodeploy/templates/kickstart_template_std.cfg",
            "vcf": "/srv/autodeploy/templates/kickstart_template_vcf.cfg"
        },
        "default_version": "8.0U3",
        "default_deployment_type": "standard",
        "auto_registration": {
            "enabled": true,
            "default_status": "pending",
            "max_wait_time": 7200,
            "retry_interval": 60,
            "notification_email": ""
        },
        "waiting_template_path": "/srv/autodeploy/templates/waiting_template.cfg"
    },
    "network": {
        "dhcp_range_start": "CHANGEME_DHCP_START",
        "dhcp_range_end": "CHANGEME_DHCP_END",
        "subnet_mask": "255.255.255.0",
        "gateway": "CHANGEME_GATEWAY",
        "dns_servers": [
            "CHANGEME_DNS1"
        ],
        "ntp_servers": [
            "CHANGEME_NTP1"
        ]
    },
    "ilo": {
        "admin_user": "Administrator",
        "scan_range_start": "CHANGEME_ILO_RANGE_START",
        "scan_range_end": "CHANGEME_ILO_RANGE_END"
    },
    "webserver": {
        "ip": "CHANGEME_SERVER_IP",
        "port": 80,
        "url": "http://CHANGEME_SERVER_IP"
    },
    "security": {
        "secure_boot_enabled": false
    },
    "paths": {
        "hosts_config": "/srv/autodeploy/config/hosts.json",
        "logs_dir": "/srv/autodeploy/logs",
        "templates_dir": "/srv/autodeploy/templates"
    }
}
